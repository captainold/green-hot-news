# Green Policy Radar — ywm.life (static site)
# Replaces moltbot.conf; same domain, reuse existing Let's Encrypt cert.

server {
    listen 80;
    listen [::]:80;
    server_name ywm.life www.ywm.life;

    # Redirect to HTTPS
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ywm.life www.ywm.life;

    ssl_certificate /etc/letsencrypt/live/ywm.life/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ywm.life/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    root /opt/green-hot-news;
    index index.html;

    # 静态文件缓存
    location ~* \.(css|js|png|jpg|jpeg|gif|svg|ico|webp)$ {
        expires 10m;
        add_header Cache-Control "public, max-age=600";
    }

    # JSON 数据不缓存（每次抓取更新）
    location ~* \.json$ {
        expires -1;
        add_header Cache-Control "no-store";
    }

    # 管理面板（Basic Auth 保护，不公开；^~ 确保正则 location 不抢先，JSON 数据也受保护）
    location ^~ /admin/ {
        auth_basic "Green Admin";
        auth_basic_user_file /etc/nginx/.green-admin-htpasswd;
        try_files $uri $uri/ =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
