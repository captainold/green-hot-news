# Green Policy Radar — ywm.life (static site)
# Replaces moltbot.conf; same domain, reuse existing Let's Encrypt cert.

server {
    listen 80;
    listen [::]:80;
    server_name ywm.life www.ywm.life;

    # Redirect to HTTPS
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ywm.life www.ywm.life;

    ssl_certificate /etc/letsencrypt/live/ywm.life/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ywm.life/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    root /opt/green-hot-news;
    index index.html;

    # HTML 不缓存（2026-08-19）：版本号靠 CSS/JS 查询串（styles.css?v=N）控制，
    # HTML 本身必须每次取最新——否则 Chrome 启发式缓存旧 index.html（引用旧版
    # CSS，如 v3 深色主题），导致"Chrome 黑底 / Wave 白底"显示不一致。
    location = /index.html {
        expires -1;
        add_header Cache-Control "no-store";
    }

    # 静态文件缓存
    location ~* \.(css|js|png|jpg|jpeg|gif|svg|ico|webp)$ {
        expires 10m;
        add_header Cache-Control "public, max-age=600";
    }

    # ── 管理面板鉴权（v2：token 保护数据，页面壳子公开）────────────────
    # 方案：/admin/data/ 单独 location（^~ 最长前缀优先），必须带 ?key=TOKEN；
    # 页面壳子 index.html 公开（无敏感内容），前端 JS 自动在 fetch 里附加 key。
    # 兼容一切浏览器（Electron/Wave 不弹 Basic Auth 框）；access_log off 防 key 进日志。
    # PITFALL: 不能用正则 location 保护 admin/data —— ^~ /admin/ 会阻断正则评估；
    # 必须用 ^~ /admin/data/ 最长前缀（同修饰符选最长）。
    location ^~ /admin/data/ {
        if ($arg_key != "<ADMIN_TOKEN>") { return 401; }
        access_log off;
        expires -1;
        add_header Cache-Control "no-store";
        try_files $uri =404;
    }

    # JSON 数据不缓存（每次抓取更新）
    location ~* \.json$ {
        expires -1;
        add_header Cache-Control "no-store";
    }

    # 管理面板（页面壳子公开，数据受 /admin/data/ 规则保护）
    location ^~ /admin/ {
        access_log off;
        try_files $uri $uri/ =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
